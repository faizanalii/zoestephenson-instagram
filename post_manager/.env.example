# =============================================================================
# Post Manager — .env.example
# =============================================================================
# Copy to .env and fill in the values.
#
# This module reads a Google Sheet, fetches Instagram post metadata
# (cookie-free, via rnet + proxies), and pushes jobs to Redis queues.

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- Proxy -------------------------------------------------------------------
# URL template with {COUNTRY} placeholder (residential rotating proxy)
PROXY=http://user__cr.{COUNTRY}:password@proxy-host:port

# Comma-separated list of country codes to rotate through
PROXY_COUNTRIES_LIST=de,be,fr,nl,us,gb,ca,au,at

# --- Google Sheets -----------------------------------------------------------
# Service account JSON file for Google Sheets auth
SHEETS_CREDENTIALS_FILE=zoecredentials.json

# Google Sheet ID containing post URLs and usernames to process
INPUT_SHEET_COMMENT_STATS=your-sheet-id

# --- Scheduling -------------------------------------------------------------
# How often to run the post manager (seconds). Set to 0 for one-shot.
# 28800 = every 8 hours  43200 = 12h  86400 = 24h
POST_MANAGER_INTERVAL=28800

# --- Performance -------------------------------------------------------------
# Number of posts to fetch in parallel (each with its own proxy)
POST_FETCH_BATCH_SIZE=20
