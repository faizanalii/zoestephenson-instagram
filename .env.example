# =============================================================================
# Instagram Comment Scraper — Production Environment
# =============================================================================
# Copy this file to .env and fill in all values before deploying.
# All services (Redis, post_manager, scraper) read from this file.

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=generate-a-strong-password-here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STATS_TABLE_NAME=instagram_stats

# --- Proxy -------------------------------------------------------------------
# Residential rotating proxy URL with {COUNTRY} placeholder
PROXY=http://user__cr.{COUNTRY}:password@proxy-host:port

# Comma-separated country codes to rotate through
PROXY_COUNTRIES_LIST=de,be,fr,nl,us,gb,ca,au,at

# --- Google Sheets -----------------------------------------------------------
# Service account JSON key filenames (place these files in each module's directory)
SHEETS_CREDENTIALS_FILE=zoecredentials.json
OUTPUT_SHEET_CREDS_FILE=tomsheetcreds.json

# Google Sheet ID with input data (post_url + username columns)
INPUT_SHEET_COMMENT_STATS=your-input-sheet-id

# Google Sheet ID where found comments are written (scraper output)
OUTPUT_SHEET_COMMENT_STATS=your-output-sheet-id

# --- Post Manager ------------------------------------------------------------
# Number of post pages to fetch concurrently (each with its own proxy)
POST_FETCH_BATCH_SIZE=5

# How often to re-read the Google Sheet and refresh queues (seconds)
# 28800 = every 8 hours  21600 = 6h  43200 = 12h  86400 = 24h
POST_MANAGER_INTERVAL=28800

# --- Scraper -----------------------------------------------------------------
# How often to drain all Redis queues (seconds). Each post is processed at most
# once per day — later runs in the same day just skip already-done posts.
# 10800 = every 3 hours  7200 = 2h  3600 = 1h
SCRAPER_INTERVAL=10800

# Max times a post can be re-queued before dead-lettering
MAX_RETRIES=5

# Max GraphQL comment pages to scan before giving up (300 pages × 50 comments = 15k)
MAX_PAGINATION_DEPTH=300

# Max consecutive rate-limit cooldowns before re-queuing
MAX_RATE_LIMIT_RETRIES=3
