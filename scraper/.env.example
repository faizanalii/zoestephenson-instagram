# =============================================================================
# Scraper — .env.example
# =============================================================================
# Copy to .env and fill in the values.
#
# This module consumes Post jobs from Redis, runs the cookie-free
# comment search pipeline, and pushes results to Supabase.

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- Supabase table names ----------------------------------------------------
SUPABASE_STATS_TABLE_NAME=instagram_stats

# --- Proxy -------------------------------------------------------------------
# URL template with {COUNTRY} placeholder (residential rotating proxy)
PROXY=http://user__cr.{COUNTRY}:password@proxy-host:port

# Comma-separated list of country codes to rotate through
PROXY_COUNTRIES_LIST=de,be,fr,nl,us,gb,ca,au,at

# --- Google Sheets -----------------------------------------------------------
# Service account JSON files for Google Sheets auth
SHEETS_CREDENTIALS_FILE=zoecredentials.json
OUTPUT_SHEET_CREDS_FILE=tomsheetcreds.json

# Google Sheet ID for output data
OUTPUT_SHEET_COMMENT_STATS=your-output-sheet-id

# --- Scheduling -------------------------------------------------------------
# How often to drain all Redis queues (seconds). 0 = continuous.
# 10800 = every 3 hours  7200 = 2h  3600 = 1h
SCRAPER_INTERVAL=10800

# --- Retry / Rate-limiting ---------------------------------------------------
MAX_RETRIES=5
MAX_PAGINATION_DEPTH=300
MAX_RATE_LIMIT_RETRIES=3
